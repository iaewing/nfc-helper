{
  "cli": {
    "version": ">= 13.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_IOS_DEV_DOMAIN": "false"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_IOS_DEV_DOMAIN": "false"
      }
    }
  }
}
